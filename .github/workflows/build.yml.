name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main]
jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
      - name: Build
        run: |
          flutter create --platforms=android --org com.extrait extrait_topo
          cp main.dart extrait_topo/lib/main.dart
          cp pubspec.yaml extrait_topo/pubspec.yaml
          sed -i '0,/<application/s//<uses-permission android:name="android.permission.INTERNET"\/>\n    <application/' extrait_topo/android/app/src/main/AndroidManifest.xml
          cd extrait_topo
          flutter pub get
          flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: extrait-topo-apk
          path: extrait_topo/build/app/outputs/flutter-apk/app-release.apk
